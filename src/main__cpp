#include <Arduino.h>
#include <SimpleFOC.h>
#include <MPU6050_tockn.h>

// I2C和IMU配置
TwoWire I2Cone = TwoWire(0);
TwoWire I2Ctwo = TwoWire(1);
MPU6050 mpu6050(I2Ctwo);

// 编码器定义
MagneticSensorI2C sensor0 = MagneticSensorI2C(AS5600_I2C);
MagneticSensorI2C sensor1 = MagneticSensorI2C(AS5600_I2C);

// 电机定义
BLDCMotor motor0 = BLDCMotor(7);
BLDCMotor motor1 = BLDCMotor(7);
BLDCDriver3PWM driver0 = BLDCDriver3PWM(32, 33, 25, 22);
BLDCDriver3PWM driver1 = BLDCDriver3PWM(26, 27, 14, 12);

// 调试参数
bool debug_mode = true;  // 用于控制调试信息输出
bool calibration_mode = true;  // 用于校准模式

// 控制器定义
// 调整PID参数以获得更稳定的控制
// 姿态控制PID
PIDController pid_stb = PIDController(
    0.5,    // P增益 (可能需要调整)
    0.01,   // I增益 (小增益有助于减少静态误差)
    0.01,   // D增益 (阻尼)
    100000.0,  // 斜坡速率 
    10.0    // 输出限制 (更宽松的限制)
);

// 速度控制PID
PIDController pid_vel = PIDController(
    0.5,    // P增益 
    0.0,    // I增益
    0.01,   // D增益
    10000.0,  // 斜坡速率
    _PI/8   // 更小的角度限制 (减缓旋转)
);

// 低通滤波器 - 减少噪声和快速变化
LowPassFilter lpf_pitch_cmd = LowPassFilter(0.05);  // 更慢的响应
LowPassFilter lpf_throttle = LowPassFilter(0.3);   // 更平滑的油门
LowPassFilter lpf_steering = LowPassFilter(0.05);  // 更慢的转向响应

// 控制参数
float steering = 0;
float throttle = 0;
float max_throttle = 40;  // 降低最大油门
float max_steering = 0.5; // 降低最大转向
float Offset_parameters = 0;  // 可能需要调整平衡点

// 校准函数 - 帮助找到精确的平衡点
void calibrate_balance_point() {
    if (!calibration_mode) return;

    Serial.println("开始平衡点校准...");
    
    // 采样多次pitch角度
    float total_pitch = 0;
    int sample_count = 200;
    
    for (int i = 0; i < sample_count; i++) {
        mpu6050.update();
        total_pitch += mpu6050.getAngleY();
        delay(10);
    }
    
    // 计算平均pitch
    Offset_parameters = total_pitch / sample_count;
    
    Serial.print("校准后的平衡点: ");
    Serial.println(Offset_parameters);
}

void I2C_init() {
    // 配置引脚
    pinMode(32, INPUT_PULLUP);
    pinMode(33, INPUT_PULLUP);
    pinMode(25, INPUT_PULLUP);
    pinMode(26, INPUT_PULLUP);
    pinMode(27, INPUT_PULLUP);
    pinMode(14, INPUT_PULLUP);

    // I2C初始化
    I2Cone.begin(19, 18, 400000UL);
    I2Ctwo.begin(23, 5, 400000UL);

    // 编码器初始化
    sensor0.init(&I2Cone);
    sensor1.init(&I2Ctwo);
}

void setup() {
    Serial.begin(115200);
    delay(750);

    // 初始化I2C和编码器
    I2C_init();

    // 初始化IMU
    Serial.println("初始化 MPU6050...");
    mpu6050.begin();
    mpu6050.calcGyroOffsets(true);

    // 校准平衡点
    calibrate_balance_point();

    // 初始化电机0
    motor0.linkSensor(&sensor0);
    motor0.voltage_sensor_align = 2;
    driver0.voltage_power_supply = 12;
    driver0.init();
    motor0.linkDriver(&driver0);
    motor0.torque_controller = TorqueControlType::voltage;
    motor0.controller = MotionControlType::torque;
    motor0.init();
    motor0.initFOC();

    delay(500);

    // 初始化电机1
    motor1.linkSensor(&sensor1);
    motor1.voltage_sensor_align = 2;
    driver1.voltage_power_supply = 12;
    driver1.init();
    motor1.linkDriver(&driver1);
    motor1.torque_controller = TorqueControlType::voltage;
    motor1.controller = MotionControlType::torque;
    motor1.init();
    motor1.initFOC();

    Serial.println("系统就绪!");
}

void loop() {
    // FOC循环
    motor0.loopFOC();
    motor1.loopFOC();
    motor0.move();
    motor1.move();

    // 更新IMU数据
    mpu6050.update();
    double mpu_pitch = mpu6050.getAngleY();
    double gyro_y = mpu6050.getGyroY();

    // 速度环
    float avg_velocity = (motor0.shaft_velocity + motor1.shaft_velocity) / 2;
    float filtered_throttle = lpf_throttle(throttle);
    float target_pitch = lpf_pitch_cmd(pid_vel(avg_velocity - filtered_throttle));

    // 姿态环
    float voltage_control = pid_stb(Offset_parameters - mpu_pitch + target_pitch);
    float steering_adj = lpf_steering(steering);

    // 输出到电机
    motor0.target = voltage_control - steering_adj;
    motor1.target = voltage_control + steering_adj;

    // 打印调试信息
    static uint32_t print_time = 0;
    if (debug_mode && millis() - print_time > 100) {  // 100ms打印一次
        print_time = millis();
        Serial.printf("调试信息:\n");
        Serial.printf("  平衡点: %.2f\n", Offset_parameters);
        Serial.printf("  当前角度: %.2f 度\n", mpu_pitch);
        Serial.printf("  陀螺仪Y轴: %.2f\n", gyro_y);
        Serial.printf("  电机速度: [%.2f, %.2f]\n", 
            motor0.shaft_velocity, motor1.shaft_velocity);
        Serial.printf("  电压控制: %.2f\n", voltage_control);
        Serial.printf("  目标角度: %.2f\n", target_pitch);
    }
}